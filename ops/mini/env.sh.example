# Source for ops/mini/env.sh. install.sh copies this file when env.sh is missing.
# env.sh is not committed (.gitignore) — every value is read from the Keychain, and only the names live here (A6 §9).
# Creating the items (once, on the mini):
#   security add-generic-password -s omnis.bridge.token.mini   -a 281932556+jinhologankim@users.noreply.github.com -w "$(openssl rand -hex 32)"
#   security add-generic-password -s omnis.zero.auth_secret    -a 281932556+jinhologankim@users.noreply.github.com -w "$(openssl rand -hex 32)"
#   security add-generic-password -s omnis.zero.admin_password -a 281932556+jinhologankim@users.noreply.github.com -w "$(openssl rand -hex 24)"

kc() { security find-generic-password -s "$1" -a 281932556+jinhologankim@users.noreply.github.com -w; }

export OMNIS_DB_URL="postgres://vigor@127.0.0.1:5432/omnis"

# --- hub ---
export DATABASE_URL="$OMNIS_DB_URL"
export OMNIS_HUB_PORT=8787
export OMNIS_USER_ID=logan
export OMNIS_BRIDGE_TOKEN="$(kc omnis.bridge.token.mini)"
export ZERO_AUTH_SECRET="$(kc omnis.zero.auth_secret)"
# Ollama resolves a model id to the tag it was actually pulled under. The mini has
# nomic-embed-text:latest, so the @omnis/memory default ("nomic-embed-text-v1.5") 404s and every
# embed() returns NULL — search goes quiet with no error in the log. 768 dims either way.
export OMNIS_OLLAMA_EMBED_MODEL="nomic-embed-text:latest"

# --- zero-cache (A6 §5, ops/zero-cache.env.example) ---
export ZERO_UPSTREAM_DB="$OMNIS_DB_URL"
export ZERO_CHANGE_DB="$OMNIS_DB_URL"
export ZERO_CVR_DB="$OMNIS_DB_URL?options=-csearch_path%3Dzero_cvr"
export ZERO_REPLICA_FILE="$HOME/omnis-var/zero-replica.db"
export ZERO_APP_PUBLICATIONS=zero_omnis
export ZERO_PORT=4848
export ZERO_ADMIN_PASSWORD="$(kc omnis.zero.admin_password)"
