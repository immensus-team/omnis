<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- A6 §1·§10. Template: install.sh substitutes __OMNIS_ROOT__ and __HOME__ and installs it into ~/Library/LaunchAgents.
     No secrets here — run.sh reads them from the Keychain via env.sh (A6 §9). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.omnis.zero-cache</string>
  <key>ProgramArguments</key>
  <array>
    <string>__OMNIS_ROOT__/ops/mini/run.sh</string>
    <string>zero-cache</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>WorkingDirectory</key><string>__OMNIS_ROOT__</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/omnis/zero-cache.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/omnis/zero-cache.err.log</string>
</dict>
</plist>
