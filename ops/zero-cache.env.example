# zero-cache (@rocicorp/zero@1.9.0) — 미니 LaunchDaemon. plist 자체는 A6 소유.
# 실행: pnpm dlx @rocicorp/zero@1.9.0 zero-cache --env-file ops/zero-cache.env

# upstream: 복제 role은 omnis_sync (0001_extensions.sql, zero-cache DB user 핀). REPLICATION 속성만 있고 superuser가 아니다.
ZERO_UPSTREAM_DB=postgres://omnis_sync@127.0.0.1:5432/omnis
# change DB / CVR DB: 같은 인스턴스의 별도 스키마로 권한 경계를 나눈다 (A6 §5).
ZERO_CHANGE_DB=postgres://omnis_sync@127.0.0.1:5432/omnis
ZERO_CVR_DB=postgres://omnis_sync@127.0.0.1:5432/omnis?options=-csearch_path%3Dzero_cvr
ZERO_REPLICA_FILE=/var/db/omnis/zero-replica.db

# ZERO_MUTATE_URL / ZERO_ENABLE_CRUD_MUTATIONS 는 Phase A에서 의도적으로 비운다 —
# 데스크톱은 읽기 전용이고, 쓰기는 전부 허브 HTTP(127.0.0.1:8787)를 거친다 (계약 §5).

# WAL 안전장치: zero-cache가 죽은 채 방치되면 슬롯이 WAL을 무한 적재한다.
# A6-D4는 postgresql.conf 의 idle_replication_slot_timeout = '3d' 를 요구하지만 이 GUC는
# PostgreSQL 18부터다 — 지금 클러스터는 17.10이라 설정할 수 없다(2026-09-20 확인).
# 17.x 동안은 아래 두 줄로 슬롯 적체를 직접 본다. 디스크 여유 50GB 미만이면 '1d' 상당으로 더 자주 본다.
#   psql -d omnis -c "SELECT name, setting FROM pg_settings WHERE name = 'idle_replication_slot_timeout'"  # 18+ 에서만 행이 나온다
#   psql -d omnis -c "SELECT slot_name, active, pg_size_pretty(pg_wal_lsn_diff(pg_current_wal_lsn(), restart_lsn)) FROM pg_replication_slots"
# 놓고 간 슬롯은 손으로 지운다: psql -d omnis -c "SELECT pg_drop_replication_slot('<slot_name>')"

# 1.9.0은 production 모드에서 admin 비밀번호가 없으면 부팅을 거부한다
# ("missing --admin-password: required in production mode", 2026-09-20 확인).
ZERO_ADMIN_PASSWORD=

# 테스트용 1회성 기동(US-A22 왕복 테스트 재현). upstream/CVR/change를 체인 테스트 DB
# 하나로 몰고, replica 파일은 버리는 경로에 둔다. 끝나면 슬롯을 반드시 손으로 지운다:
#   psql -d <chain-db> -c "SELECT pg_drop_replication_slot('zero_0_a')"
#   ZERO_UPSTREAM_DB=postgres://logankim@127.0.0.1:5432/<chain-db> \
#   ZERO_CVR_DB=$ZERO_UPSTREAM_DB ZERO_CHANGE_DB=$ZERO_UPSTREAM_DB \
#   ZERO_REPLICA_FILE=/tmp/zero-replica-<chain>.db ZERO_APP_PUBLICATIONS=zero_omnis \
#   ZERO_PORT=4848 ZERO_ADMIN_PASSWORD=local-scratch-only \
#   ./apps/desktop/node_modules/.bin/zero-cache
# 그 뒤 왕복 테스트는 주소를 명시해야 수집된다(없으면 skip — apps/desktop/test/integration/zero-client.test.ts):
#   OMNIS_ZERO_URL=http://127.0.0.1:4848 pnpm test:integration
