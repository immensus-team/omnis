# zero-cache (@rocicorp/zero@1.9.0) — mini LaunchDaemon. The plist itself is owned by A6.
# Run: pnpm dlx @rocicorp/zero@1.9.0 zero-cache --env-file ops/zero-cache.env

# upstream: the replication role is omnis_sync (0001_extensions.sql, the zero-cache DB user pin). It has only the REPLICATION attribute and is not a superuser.
ZERO_UPSTREAM_DB=postgres://omnis_sync@127.0.0.1:5432/omnis
# change DB / CVR DB: separate schemas on the same instance split the privilege boundary (A6 §5).
ZERO_CHANGE_DB=postgres://omnis_sync@127.0.0.1:5432/omnis
ZERO_CVR_DB=postgres://omnis_sync@127.0.0.1:5432/omnis?options=-csearch_path%3Dzero_cvr
ZERO_REPLICA_FILE=/var/db/omnis/zero-replica.db

# US-A21b auth: the hub (GET /api/zero-token) signs with HS256 and zero-cache verifies with this symmetric key.
# The hub process and zero-cache must be given the **same value** (the env var name on the hub side is also ZERO_AUTH_SECRET).
# If it is empty, the hub returns 503 on /api/zero-token, and the desktop connects without a token and cannot see a single row.
ZERO_AUTH_SECRET=
# The token's sub. permissions compares against this value. Read by both the hub and zero-deploy-permissions.
OMNIS_USER_ID=logan

# permissions deploy: once, after migrations and before starting zero-cache.
# Re-run it whenever the schema (zero-schema.ts) or OMNIS_USER_ID changes — if you do not, zero-cache comes up
# with "no tables will be syncable", so queries resolve but there are 0 rows (the symptom US-A22 saw).
#   ZERO_UPSTREAM_DB=postgres://logankim@127.0.0.1:5432/omnis OMNIS_USER_ID=logan \
#   pnpm zero:deploy-permissions

# ZERO_MUTATE_URL / ZERO_ENABLE_CRUD_MUTATIONS are intentionally left empty in Phase A —
# the desktop is read-only, and every write goes through the hub HTTP (127.0.0.1:8787) (contract §5).

# WAL safeguard: if zero-cache dies and is left unattended, the slot accumulates WAL without bound.
# A6-D4 requires idle_replication_slot_timeout = '3d' in postgresql.conf, but this GUC only exists
# as of PostgreSQL 18 — the current cluster is 17.10, so it cannot be set (confirmed 2026-09-20).
# On 17.x, watch slot buildup directly with the two lines below. If free disk is under 50GB, check more often, on the order of '1d'.
#   psql -d omnis -c "SELECT name, setting FROM pg_settings WHERE name = 'idle_replication_slot_timeout'"  # rows appear only on 18+
#   psql -d omnis -c "SELECT slot_name, active, pg_size_pretty(pg_wal_lsn_diff(pg_current_wal_lsn(), restart_lsn)) FROM pg_replication_slots"
# Delete abandoned slots by hand: psql -d omnis -c "SELECT pg_drop_replication_slot('<slot_name>')"

# 1.9.0 refuses to boot in production mode without an admin password
# ("missing --admin-password: required in production mode", confirmed 2026-09-20).
ZERO_ADMIN_PASSWORD=

# One-off boot for tests (reproduces the US-A22 round-trip test). Funnel upstream/CVR/change into a single
# chain-test DB, and put the replica file on a throwaway path. When done, you must delete the slot by hand:
#   psql -d <chain-db> -c "SELECT pg_drop_replication_slot('zero_0_a')"
#   ZERO_UPSTREAM_DB=postgres://logankim@127.0.0.1:5432/<chain-db> \
#   ZERO_CVR_DB=$ZERO_UPSTREAM_DB ZERO_CHANGE_DB=$ZERO_UPSTREAM_DB \
#   ZERO_REPLICA_FILE=/tmp/zero-replica-<chain>.db ZERO_APP_PUBLICATIONS=zero_omnis \
#   ZERO_PORT=4848 ZERO_ADMIN_PASSWORD=local-scratch-only ZERO_AUTH_SECRET=local-scratch-only \
#   ./apps/desktop/node_modules/.bin/zero-cache
# After that, the round-trip test is only collected if you name the address (otherwise it is skipped — apps/desktop/test/integration/zero-client.test.ts):
#   OMNIS_ZERO_URL=http://127.0.0.1:4848 ZERO_AUTH_SECRET=local-scratch-only pnpm test:integration
